---
import BaseHead from '../components/BaseHead.astro';
import Filters from '../components/Filters.astro';

const { title, description = 'Scott Kellum is an internationally-recognized leader in design for the web, with a specialized focus on dynamic typesetting in digital space.', image = '/preview.png', fedi = '@scott@typetura.social' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Filters />
    <slot />
	</body>
</html>

<script src="../scripts/keyboard-navigation.js"></script>