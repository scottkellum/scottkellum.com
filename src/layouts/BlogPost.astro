---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Nav from '../components/Nav.astro';

import Footer from '../components/Footer.astro';
import Grid from '../components/Grid.astro';

type Props = CollectionEntry<'blog'>['data'];
let { title, description, pubDate, heroImage, alt } = Astro.props;

const posts = (await getCollection('blog')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

let nextPost = posts[0]; // Get the next post
if (nextPost.data.title === title) {
	nextPost = posts[1]; // Get the next post
}

let author = 'Scott Kellum';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Scott Kellum`} description={description} image={heroImage} />
	</head>
	<body>
		<section class="lede wrapper">
			<div class="content tt">
				<div class="hero-image">
					{heroImage && <img width={441} height={441} src={heroImage} alt={alt} />}
				</div>
				<div class="hgroup cq">
					<p class="date">
						<FormattedDate date={pubDate} />
					</p>
					<h1 class="page-head">{title}</h1>
					<p class="author">By {author}</p>
				</div>
			</div>
		</section>
		
		<Nav />

		<main class="main wrapper">
			<div class="content prose">
				<slot />
				<div class="content">
					<h2>Read next</h2>
					<div class="next-post">
						<a href={`/blog/${nextPost.slug}/`}>
							<h3>{nextPost.data.title}</h3>
							<img src={nextPost.data.heroImage} alt={nextPost.data.alt} width="441" height="441" />
						</a>
					</div>
				</div>
			</div>

			<section class="end">
				<div class="content clients">
					<div class="prose">
						<h2>Website or brand feeling a little stale?</h2>
						<p>We get it! We can help you with a variety of projects from large branding exercises and website builds to quick fixes and design refreshes. We’ve worked with individuals, editorial clients, government agencies, type foundries, and educational institutions. We’d love to work with you too.</p>
					</div>
					<a href="https://calendly.com/typetura/30min" target="_blank" class="cta">Schedule a quick call</a>
				</div>
			</section>
		</main>

		<Footer />
		<Grid />
	</body>
</html>

<style>
	.lede > .content {
		padding-block-start: 0;
	}
	.lede > .content > * {
		flex: 1;
	}
	.lede .hero-image {
		margin-block: 0;
	}
	.lede img {
		margin: 0.5px;
		margin-block-start: 0;
		border-radius: 0 0 4rem 4rem;
		outline: 1px solid var(--accent-dark);
	}
	.hgroup {
		align-self: flex-end;
		margin-block-start: 1rem;
	}
	@media (min-width: 55em) {
		.lede > .content {
			display: flex;
			grid-gap: 1rem;
			width: 100%;
		}
	}

	.date,
	.author {
		font-size: 0.7rem;
		color: var(--primary-dark);
		font-family: var(--gamay);
	}

	img {
		width: 100%;
		height: auto;
		display: block;
		margin-block-start: 2rem;
	}


	.next-post a {
		display: flex;
		flex-direction: row;
		gap: 1rem;
		align-items: center;
		text-decoration: none;
	}
	.next-post a:hover {
		text-decoration: underline;
	}
	.next-post img {
		order: 1;
		height: 6rem;
		width: 6rem;
		min-width: 6rem;
		margin: 0;
		padding: 0;
	}
	.next-post h3 {
		order: 2;
		margin: 0;
		padding: 0;
		line-height: 1;
	}

	.end {
		grid-column-end: span 3;
		background-color: var(--background);
		border-top: 1px solid var(--accent-dark);
		display: grid;
		grid-template-columns: subgrid;
		margin-block: 2rem -2rem;
	}
	@media (min-width: 40em) {
		.end {
			margin-block: 3rem -4rem;
		}
	}
	.end .content {
		outline: 1px dashed var(--accent-dark);
		margin-inline: 0.5px;
		width: calc(100% - 1px);
		box-sizing: border-box;
		padding: 3rem 1rem;
	}

	.clients {
		text-align: center;
		text-wrap: balance;
	}
	.clients h2 {
		margin-block: 0;
		padding-block: 0;
	}
	.clients h2::before {
		display: none;
	}

	.cta {
		font-family: var(--gamay);
		color: var(--action);
		font-size: 1.25rem;
		font-weight: 500;
	}
</style>