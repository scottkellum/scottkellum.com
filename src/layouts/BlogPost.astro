---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'work'>['data'];
let { title, description, pubDate, heroImage, heroWide, alt, readNext } = Astro.props;

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

let nextPost;
if (readNext) {
	nextPost = work.find(post => post.slug === readNext);
} else {
	nextPost = work[0]; // Get the next post
	if (nextPost.data.title === title) {
		nextPost = work[1]; // Get the next post
	}
}

let author = 'Scott Kellum';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Scott Kellum`} description={description} image={heroImage} />
		<link rel="preconnect" href="https://typographer.io/">
		<link rel="stylesheet" href="https://typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d">
		<script type="module">try{navigator.sendBeacon("https://use.typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d")}catch{}</script>
	</head>
	<body>
			<!-- <hgroup class={`content tt ${heroWide ? 'has-hero-wide' : ''}`}>
				<h1 class="hed">{title}</h1>
				<p class="date"><FormattedDate date={pubDate} /></p>
			</hgroup> -->

			<hgroup class={`content tt ${heroWide ? 'has-hero-wide' : ''}`}>
				<h1 class="hed">{title}</h1>
				<p class="date"><FormattedDate date={pubDate} /></p>
			</hgroup>

			<div class="cols">
				<div class="wrap">
					<div class="inner">
						<slot />
					</div>
				</div>
			</div>
<!-- 
				<div class="end">
					<a href={`/portfolio/${nextPost.slug}/`}>
						<h3>{nextPost.data.title}</h3>
						<img src={nextPost.data.heroImage} alt={nextPost.data.alt} width="441" height="441" />
					</a>
				</div>
			</article>
		</main>
		<footer>
			<a href="/" class="publicatoin">
				Publication
			</a>
		</footer> -->
	</body>
</html>

<style>

	html,
	body {
		height: 100%;
	}

	body {
		writing-mode: sideways-lr;
	}
	body > * {
		writing-mode: horizontal-tb;
	}
	hgroup {
		column-height: var(--page-height);
		scroll-snap-align: start;
		box-shadow: inset 0 0 0 1px green;
		height: 100%;
		padding: 4rem;
		box-sizing: border-box;
	}

	html {
		scroll-snap-type: x mandatory;
		--page-margin: 2rem;
		--column-height: 60vh;
		--page-height: 90vh;
		--primary: hsl(20deg 80% 40%);
		--background: #fff;

		--font-text: 'Bennet Text', serif;
		--font-display: 'Bennet Banner', serif;
		--font-meta: 'IvyEpic', system-ui;
		font-family: var(--font-text);
		line-height: 1.3;
		background-color: var(--background);
		scrollbar-color: var(--primary) var(--background);
		scrollbar-width: thin;
	}

	html, body {
		height: 100%;
		margin: 0;
		padding: 0;
	}

	.inner :global(p) {
		margin-block: 0;
		text-indent: 25%;
	}

	.inner :global(h1),
	.inner :global(h2),
	.inner :global(h3),
	.inner :global(h4),
	.inner :global(h5),
	.inner :global(h6) {
		font-size: 1em;
		line-height: 1rlh;
		font-weight: 700;
		margin-block: 1rlh 0;
		break-inside: avoid;
	}

	.inner :global(h2) {
		font-size: 1.33rlh;
		line-height: 1rlh;
		margin-block: 1rlh;
		font-family: var(--font-display);
	}

	.inner :global(h1 + p),
	.inner :global(h2 + p),
	.inner :global(h3 + p),
	.inner :global(h4 + p),
	.inner :global(h5 + p),
	.inner :global(h6 + p) {
		text-indent: 0;
	}

	
	.inner :global(p:first-child) {
		text-indent: 0;
		margin-top: -3lh;
	}
	.inner :global(p:first-child:first-letter) {
		initial-letter: 6 3;
		font-weight: 500;
		color: var(--primary);
		margin-inline-end: 1rem;
		font-family: var(--font-display);
	}

	.cols {
		columns: 1;
		height: 100%;
		gap: 0;
		margin: 0;
		column-fill: auto;
		width: 100vw;
	}
	.cols::column {
		scroll-snap-align: center;
	}

	.wrap {
		padding: calc(var(--page-height) - var(--column-height)) var(--page-margin) var(--page-margin);
		box-decoration-break: clone;
		box-shadow: inset 0 0 0 1px red;
	}

	.inner {
		gap: 2rem;
		column-width: 18rem;
		column-height: var(--column-height);
		column-fill: auto;
		text-align: justify;
		hyphens: auto;
		orphans: 2;
		widows: 3;
	}
</style>