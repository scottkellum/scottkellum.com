---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Filters from '../components/Filters.astro';

type Props = CollectionEntry<'work'>['data'];
let { title, description, pubDate, heroImage, heroWide, alt, readNext } = Astro.props;

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

let nextPosts;
if (readNext) {
	const customPost = work.find(post => post.slug === readNext);
	nextPosts = customPost ? [customPost] : [];
} else {
	// Get 3 latest posts that aren't the current post
	nextPosts = work.filter(post => post.data.title !== title).slice(0, 3);
}

let author = 'Scott Kellum';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Scott Kellum`} description={description} image={heroImage} />
		<link rel="preconnect" href="https://typographer.io/">
		<link rel="stylesheet" href="https://typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d">
		<script type="module">try{navigator.sendBeacon("https://use.typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d")}catch{}</script>
	</head>
	<body>

		<Filters />

		<hgroup class={`content tt ${heroWide ? 'has-hero-wide' : ''}`}>
				<h1 class="hed">{title}</h1>
				<p class="date"><FormattedDate date={pubDate} /></p>
				<img src={heroImage} alt={alt} width="600" height="600" />
			</hgroup>

			<div class="cols">
				<div class="wrap">
					<div class="inner">
						<slot />
					</div>
			    <div class="end" id="end">
						<ul>
							{nextPosts && nextPosts.map(post => (
								<li>
									<img src={post.data.heroImage} alt={post.data.alt} width="600" height="600" />
									<a href={`/work/${post.slug}`}>
										{post.data.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		<footer>
			<a href="/" class="publication">
				Scott Kellum
			</a>
		</footer>
	</body>
</html>

<style>
	html {
		--gutter: min(2rem, 5vw);
		--column-height: 60vh;
		--page-height: 90vh;
		--primary: hsl(42, 100%, 44%);
		--foreground: #000;
		--background: #f4f2ee;
		--background-alt: hsl(0 0 100% / 0.5);

		--gradient-stops: ;

		--font-text: 'Bennet Text', serif;
		--font-display: 'Bennet Banner', serif;
		--font-meta: 'IvyEpic', system-ui;

		font-family: var(--font-text);
		line-height: 1.3;
		color: var(--foreground);
		background-color: var(--background);
		scrollbar-color: var(--primary) var(--background);
		scrollbar-width: none;
		scroll-snap-type: x mandatory;
		scroll-marker-group: before;
		scroll-behavior: smooth;
	}
	@media (prefers-color-scheme: dark) {
		html {
			--primary: hsl(42, 100%, 60%);
			--foreground: #fff;
			--background: #000;
			--background-alt: hsl(0 0 100% / 0.1);
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
		}
	}

	html,
	body {
		height: 100%;
		margin: 0;
		padding: 0;
	}

	/* Orient the page flow direction as horizontal */
	html {
		writing-mode: sideways-lr;
	}
	body > * {
		writing-mode: horizontal-tb;
	}

	/* SVG Filters */

	.svg-filters {
		position: absolute;
	}

	/* Scroll markers */

	::scroll-marker-group {
		writing-mode: horizontal-tb;
		position: fixed;
		display: flex;
		justify-content: center;
		align-items: center;
		top: 0;
		left: 0;
		right: 0;
		gap: min(0.33rem, 1vw);
		z-index: 9;
		padding: 0.5rem;
		height: 1rem;
	}
	hgroup::scroll-marker,
	.cols::column::scroll-marker {
		font-size: min(0.5rem, 2vw);
		color: inherit;
		background: color-mix(in srgb, var(--foreground) 40%, transparent 60%);
		display: block;
		width: 1em;
		height: 1em;
		padding: 0;
		content: "";
		border-radius: 9em;
		transition: all 0.2s ease-in-out;
		outline: 1px solid color-mix(in srgb, var(--background) 33%, transparent 67%);
	}
	::column::scroll-marker:hover,
	::scroll-marker:hover {
		width: 1.5em;
		height: 1.5em;
	}
	::column::scroll-marker:target-current:hover,
	::scroll-marker:target-current:hover {
		width: 3.5em;
	}
	::column::scroll-marker:target-current,
	::scroll-marker:target-current {
		width: 2.5em;
		background: color-mix(in srgb, var(--foreground) 75%, transparent 25%);
	}

	/* Scroll buttons */
	html::scroll-button(*) {
		writing-mode: horizontal-tb;
		position: fixed;
		background: none;
		margin: 0;
		padding: 0;
		padding-block: 0.2em 0.6em;
		right: var(--gutter);
		bottom: 0;
		border: 0;
		cursor: pointer;
		z-index: 9;
		font-family: inherit;
		font-size: 0.7rem;
		font-family: var(--font-meta);
		font-weight: 300;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #fff;
		mix-blend-mode: difference;
		transition: opacity 0.3s ease-in-out;
	}

	html::scroll-button(*):hover,
	html::scroll-button(*):focus {
		text-decoration: underline;
	}

	html::scroll-button(*):disabled {
		opacity: 0;
		cursor: unset;
	}

	html::scroll-button(left) {
		content: "Previous";
		left: var(--gutter);
		right: auto;
	}

	html::scroll-button(right) {
		content: "Next";
	}

	::selection {
		background: color-mix(in hsl, transparent, var(--primary));
	}

	/* The lede or cover */
	hgroup {
		position: relative;
		display: grid;
		grid-template-rows: 1fr min-content 2fr;
		grid-template-columns: 1fr auto;
		gap: 0 1rem;
		column-height: var(--page-height);
		scroll-snap-align: start;
		height: 100%;
		padding: 2rem;
		padding-inline-start: max(2rem, 8vw);
		padding-inline-end: 4rem;
		margin-inline-end: calc(var(--gutter) / 2);
		box-sizing: border-box;
		width: clamp(90vw,40rem, 100vw);
	}

	hgroup .hed {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 10vw, 5rem);
		line-height: 1;
		margin-block: var(--gutter);
		text-wrap: balance;
		grid-row: 2 / 3;
		grid-column: 1 / -1;
	}

	hgroup .date {
		font-family: var(--font-meta);
		font-size: 0.9em;
		color: var(--primary);
		margin-block: 0;
		grid-row: 3 / 4;
		text-align: right;
	}

	hgroup img {
		grid-row: 3 / 4;
		aspect-ratio: 1 / 1;
		width: auto;
		height: auto;
		max-width: calc(100vw - 12rem);
		max-height: min(100%, 40vh);
		position: relative;
		z-index: -1;
		outline: 8rem solid var(--background-alt);
		margin-bottom: 20rem;
	}
	@media (width < 42em) {
		hgroup {
			padding-inline-end: 0rem;
		}
		hgroup img {
			outline: 4rem solid var(--background-alt);
		}
	}

	hgroup::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		mix-blend-mode: multiply;
		filter: url(#topography);
		z-index: -1;
		background:
		radial-gradient(
					ellipse at 0% 100% in oklch,
				hsl(210 100% 80% / 1),
				hsl(30 100% 80% / 0) 90vw
			);
	}
	@media (prefers-color-scheme: dark) {
		hgroup::before {
			mix-blend-mode: screen;
			background:
			radial-gradient(
					ellipse at 0% 100% in oklch,
					hsl(190 60% 30% / 1),
					hsl(30 100% 80% / 0) 90vw
				);
		}
	}

	/* General text styles */

	.inner :global(p) {
		margin-block: 0;
		text-indent: 25%;
		text-wrap: pretty;
	}

	.inner :global(h1),
	.inner :global(h2),
	.inner :global(h3),
	.inner :global(h4),
	.inner :global(h5),
	.inner :global(h6) {
		text-wrap: balance;
		font-size: 1em;
		line-height: 1rlh;
		font-weight: 700;
		margin-block: 1rlh 0;
		break-inside: avoid;
		text-align: left;
		break-after: avoid;
	}

	.inner :global(h2) {
		font-size: 1rlh;
		line-height: 1rlh;
		margin-block: 0.5rlh;
	}

	.inner :global(h1 + p),
	.inner :global(h2 + p),
	.inner :global(h3 + p),
	.inner :global(h4 + p),
	.inner :global(h5 + p),
	.inner :global(h6 + p) {
		text-indent: 0;
	}
	
	.inner :global(ul),
	.inner :global(ol) {
		margin-inline: 0.75lh 0;
		padding-inline: 0;
		margin-block: 0 1lh;
		text-align: left;
		font-size: 0.9em;
		line-height: 1rlh;
	}
	.inner :global(ul ::marker),
	.inner :global(ol ::marker) {
		color: var(--primary);
	}
	.inner :global(ul p),
	.inner :global(ol p) {
		text-indent: 0;
	}

	.inner :global(a) {
		color: inherit;
		text-decoration-color: color-mix(in srgb, var(--primary) 30%, transparent 70%);
		transition: text-decoration-color 0.25s ease-in-out;
		text-decoration-thickness: 0.1rem;
		text-underline-offset: 0.15rem;
	}
	.inner :global(a:hover),
	.inner :global(a:focus) {
		text-decoration-color: var(--primary);
	}

	/* Bento */
	.inner :global(.bento) {
		display: flex;
		flex-wrap: wrap;
		gap: 1px;
		margin-block: 1rlh;
		list-style: none;
		break-inside: avoid;
	}
	.inner :global(.bento:first-child) {
		margin-block-start: 0;
	}
	.inner :global(.bento .box) {
		flex: 1;
		background: var(--primary);
		color: #fff;
		padding: 1rem;
		line-height: 1;
	}
	.inner :global(.bento .value) {
		font-size: 3rem;
	}
	.inner :global(.bento p) {
		text-indent: 0;
		display: flex;
		flex-direction: column;
		text-align: center;
	}
	.inner :global(.bento + p) {
		text-indent: 0;
	}

	/* Testimonials */
	.inner :global(ul.testimonials) {
		list-style: none;
		margin: 0;
		margin-block: 1rlh;
		break-inside: avoid;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
	}
	.inner :global(ul.testimonials .quote) {
		font-size: 1.5em;
		line-height: 1.3;
		font-style: italic;
	}
	.inner :global(ul.testimonials .quote::before),
	.inner :global(ul.testimonials .quote::after) {
		content: '“';
		font-size: 2em;
		line-height: 0;
		vertical-align: -0.25em;
		color: var(--primary);
		margin-inline: 0 0.05em;
	}
	.inner :global(ul.testimonials .quote::after) {
		content: '”';
		margin-inline: 0.05em 0;
	}
	.inner :global(ul.testimonials .cite) {
		font-size: 0.9em;
		margin-top: 0.5em;
	}

	.inner > :global(p:last-child::after) {
		content: ' ✶';
		color: var(--primary);
	}

	/* CTA */
	.inner :global(p:has(.cta)) {
		text-indent: 0;
		font-size: 1.67rem;
		margin: 0;
		break-inside: avoid;
		min-height: var(--column-height);
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
	}

	/* Images and figures */
	.inner :global(img) {
		width: 100%;
		height: auto;
		margin-block: 1rlh;
		break-inside: avoid;
		object-position: center;
	}
	.inner :global(.wide) {
		position: relative;
		height: 100vh;
		top: calc(var(--column-height) - var(--page-height));
		width: 100%;
		break-before: column;
		break-after: column;
		break-inside: avoid;
		margin: 0;
		object-fit: contain;
		z-index: 1;
	}
	.inner :global(.full) {
		position: relative;
		object-fit: cover;
		height: 100vh;
		margin: 0;
		z-index: 1;
		top: calc(var(--column-height) - var(--page-height));
	}
	@media (width >= 42em) {
		.inner :global(.wide) {
			width: calc(200% + var(--gutter));
		}
		.inner :global(.wide + *::before) {
			content: '';
			display: block;
			break-before: column;
			break-after: column;
			break-inside: avoid;
			width: 1rem;
			height: 1rem;
		}
	}
	@media (width >= 82em) {
		.inner :global(.wide) {
			width: calc(300% + (var(--gutter) * 2));
			margin-inline-start: calc(-100% - var(--gutter));
		}
		.inner :global(*:has(+ .wide))::after {
			content: '';
			display: block;
			break-before: column;
			break-after: column;
			break-inside: avoid;
			width: 1rem;
			height: 1rem;
		}
	}
	.inner :global(img + em) {
		display: block;
		font-size: 0.8em;
		margin-block: -0.5rlh 1rlh;
		text-align: left;
		text-wrap: balance;
	}

	/* Dropcap */
	.inner > :global(p:first-child) {
		text-indent: 0;
		margin-top: -3lh;
	}
	.inner > :global(p:first-child:first-letter) {
		initial-letter: 6 3;
		font-weight: 500;
		color: var(--primary);
		margin-inline-end: 1rem;
		font-family: var(--font-display);
	}

	/* Pagination logic */
	.cols {
		columns: 1;
		height: 100%;
		gap: 0;
		margin: 0;
		column-fill: auto;
		width: calc(100vw - var(--gutter));
	}
	.cols::column {
		scroll-snap-align: center;
	}

	.wrap {
		padding: calc(var(--page-height) - var(--column-height)) calc(var(--gutter) / 2) var(--gutter);
		box-decoration-break: clone;
	}

	.inner {
		gap: var(--gutter);
		column-width: 20rem;
		column-height: var(--column-height);
		column-fill: auto;
		text-align: justify;
		hyphens: auto;
		orphans: 2;
		widows: 3;
		position: relative;
	}

	@media (width < 42em) {
		html {
			--column-height: 80vh;
		}
		.inner > p:first-child {
			margin-top: 0;
		}
		.inner > p:first-child:first-letter {
			initial-letter: 4 2;
		}
	}

	/* End */
	.end {
		break-before: column;
		break-inside: avoid;
		display: grid;
		place-content: center;
		font-family: var(--font-display);
		line-height: 1;
		
		position: relative;
		width: 100vw;
		box-sizing: border-box;
		height: calc(100vh - var(--gutter));
		margin-block: calc(var(--column-height) - var(--page-height)) calc(var(--gutter) * -2);
		margin-inline: calc(var(--gutter) * -1) 0;
		padding-inline: 0;
	}

	.end ul,
	.end li {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.end ul {
		display: grid;
		position: absolute;
		inset: 0;
		grid-template-areas:
			"a b"
			"a c";
		grid-template-columns: 2fr 1fr;
		align-items: stretch;
		gap: var(--gutter);
		margin: var(--gutter);
	}
	@media (aspect-ratio < 0.8) {
		.end ul {
			grid-template-areas:
				"a"
				"b"
				"c";
			grid-template-columns: 1fr;
		}
	}

	.end li {
		display: flex;
		position: relative;
		container-type: inline-size;
		flex-direction: column;
		/* background: var(--foreground);
		color: var(--background);
		overflow: hidden; */
		outline: 0.25rem solid transparent;
		transition: outline 0.2s ease-out;
	}
	.end li:has(a:hover),
	.end li:has(a:focus) {
		outline: 0.25rem solid var(--primary);
	}

	.end img {
		width: 100%;
		height: 100px;
		object-fit: cover;
		flex: 1 0 0;
	}

	.end a {
		color: inherit;
		text-decoration-color: transparent;
		transition: text-decoration-color 0.25s ease-in-out;
		text-decoration-thickness: 0.1rem;
		text-underline-offset: 0.15rem;
		font-size: clamp(1.25rem, 14cqi, 4rem);
		flex: 0 0 0;
		padding: 1rem 0 0;
		/* -webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale; */
	}
	.end a:hover,
	.end a:focus {
		text-decoration-color: var(--primary);
	}
	.end a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.end li:first-child { grid-area: a }
	.end li:nth-child(2) { grid-area: b }
	.end li:nth-child(3) { grid-area: c }

	.end::before {
		content: '';
		position: absolute;
		inset: 0;
		inset-inline: -100vw 0;
		width: 200vw;
		pointer-events: none;
		mix-blend-mode: multiply;
		filter: url(#topography);
		background:
		radial-gradient(
				ellipse at 100% -10% in oklch,
				hsl(210 100% 80% / 1),
				hsl(30 100% 100% / 0) 200vw
			);
	}
	@media (prefers-color-scheme: dark) {
		.end::before {
			mix-blend-mode: screen;
			background:
			radial-gradient(
					ellipse at 100% -10% in oklch,
					hsl(190 60% 30% / 1),
					hsl(30 80% 40% / 0) 200vw
				);
		}
	}

	/* Footer */
	footer {
		position: fixed;
		bottom: 0;
		font-family: var(--font-meta);
		inset-inline: var(--gutter);
		border-top: 1px solid var(--primary);
		font-size: 0.7rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding-block: 0.2em 0.6em;
		text-align: center;
	}
	footer a {
		color: inherit;
		text-decoration: none;
	}
	footer a:hover,
	footer a:focus {
		text-decoration: underline;
	}
</style>