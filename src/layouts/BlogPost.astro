---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Nav from '../components/Nav.astro';

import Footer from '../components/Footer.astro';
import Grid from '../components/Grid.astro';
import CooperType from '../components/CooperType.astro';

type Props = CollectionEntry<'work'>['data'];
let { title, description, pubDate, heroImage, alt } = Astro.props;

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);

let nextPost = work[0]; // Get the next post
if (nextPost.data.title === title) {
	nextPost = work[1]; // Get the next post
}

let author = 'Scott Kellum';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Scott Kellum`} description={description} image={heroImage} />
	</head>
	<body>
		<section class="lede wrapper">
			<div class="content tt">
				<div class="hero-image">
					{heroImage && <img width={441} height={441} src={heroImage} alt={alt} />}
				</div>
				<div class="hgroup cq">
					<p class="date">
						<FormattedDate date={pubDate} />
					</p>
					<h1 class="page-head">{title}</h1>
					<p class="author">By {author}</p>
				</div>
			</div>
		</section>
		
		<Nav />

		<main class="main wrapper">
			<div class="content prose">
				<slot />
				<div class="content">
					<h2>Read next</h2>
					<div class="next-post">
						<a href={`/work/${nextPost.slug}/`}>
							<h3>{nextPost.data.title}</h3>
							<img src={nextPost.data.heroImage} alt={nextPost.data.alt} width="441" height="441" />
						</a>
					</div>
				</div>
			</div>
		</main>

		<CooperType />
		<Footer />
		<Grid />
	</body>
</html>

<style>
	.lede > .content {
		padding-block-start: 0;
	}
	.lede > .content > * {
		flex: 1;
	}
	.lede .hero-image {
		margin-block: 0;
	}
	.lede img {
		margin: 0.5px;
		margin-block-start: 0;
		border-radius: 0 0 4rem 4rem;
		outline: 1px solid var(--accent-dark);
	}
	.hgroup {
		align-self: flex-end;
		margin-block-start: 1rem;
	}
	.page-head {
		font-family: var(--display);
	}
	@media (min-width: 55em) {
		.lede > .content {
			display: flex;
			grid-gap: 1rem;
			width: 100%;
		}
	}

	.date,
	.author {
		font-size: 0.7rem;
		color: var(--primary-dark);
	}

	img {
		width: 100%;
		height: auto;
		display: block;
		margin-block-start: 2rem;
	}


	.next-post a {
		display: flex;
		flex-direction: row;
		gap: 1rem;
		align-items: center;
		text-decoration: none;
	}
	.next-post a:hover {
		text-decoration: underline;
	}
	.next-post img {
		order: 1;
		height: 6rem;
		width: 6rem;
		min-width: 6rem;
		margin: 0;
		padding: 0;
	}
	.next-post h3 {
		order: 2;
		margin: 0;
		padding: 0;
		line-height: 1;
	}

	.clients {
		text-align: center;
		text-wrap: balance;
	}
	.clients h2 {
		margin-block: 0;
		padding-block: 0;
	}
	.clients h2::before {
		display: none;
	}
</style>