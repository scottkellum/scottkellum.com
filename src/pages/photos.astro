---
// Component Imports
import Filmstrip from '../components/Filmstrip.astro';
import HomeLink from '../components/HomeLink.astro';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let title = 'Scott Kellum’s Photographs';
let description = 'Photos taken by Scott Kellum. Most on Ilford HP5+ film with my Leica M3 and Vöigtlander 50mm f1.5 Nokton MC II';
---

<html lang="en">
	<head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator} />

    <!-- Font preloads -->
    <link rel="preconnect" href="https://typographer.io/">
    <link rel="stylesheet" href="https://typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d">
    <script type="module">try{navigator.sendBeacon("https://use.typographer.io/1/users/7fed6df4c187946a210959b4ecd1556d39d9ff919812fad8e95fde2c6be2e1a2/1e97126c063332188209513aaa63aaa89fad45c5606c776361438b808e5d5c30/css?token=f8632f052d")}catch{}</script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description ? description : ''} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="https://scottkellum.com/rss.xml">

    <!-- App icons -->
    <link rel="apple-touch-icon" sizes="512x512" href="/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Mastodon verification links -->
    <link rel="me" href="https://typetura.social/@typetura">
    <link rel="me" href="https://typetura.social/@scott">
    <meta name="fediverse:creator" content="@scott@typetura.social" />

      <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title}`} />
    <meta property="og:description" content={description} />

		<style>
			:root {
        background: #000;
        --blend: screen;
        --primary: #FF6C4B;

        scrollbar-color: var(--primary) transparent;
        scrollbar-width: thin;
        overscroll-behavior: none;

        --mono: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
			}
      body {
        container-type: inline-size;
        margin: 0;
      }
      h1 {
        scroll-snap-align: start;
        color: #ccc;
        font: inherit;
        font-family: var(--mono);
        padding: 2rem;
        font-weight: 400;
      }
      @media (max-height: 60em) {
        :root {
          scroll-snap-type: y mandatory;
        }
      }
      @keyframes photos-html {
        0% {
          font-size: 0%;
        }
      }
		</style>
	</head>

	<body>
    <HomeLink />
    <h1>Scott’s Photography</h1>
		<main>
	      <Filmstrip />
		</main>
	</body>
</html>
