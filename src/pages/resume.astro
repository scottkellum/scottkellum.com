---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import { SITE_DESCRIPTION } from '../consts';
import KeepScrolling from '../components/KeepScrolling.astro';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'

let rolls = photos.rolls;

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const pinnedPosts = work.filter((post) => post.data.pinned);
---

<Landing title="Scott Kellum — Résumé" description={SITE_DESCRIPTION}>

	<section class="lede wrapper">
		<div class="content tt">
			<h1 class="page-head">Scott Kellum</h1>
			<p class="meta">Strategy & Design Leader with B2B, SAAS, Editorial, and Product Expertise</p>
			<p>A proven leader in design and technology innovation with 20+ years of experience, driven to achieve goals at a high standard of quality, I am seeking a challenging opportunity to manage and lead large projects where my advanced skills, entrepreneurial mindset, extensive training, and many years of experience can be fully utilized.</p>
		</div>
	</section>
	
	<KeepScrolling />

	<Nav />

	<main class="main wrapper" id="solutions">
		<section class="featured prose" id="featured-work">

			<ul>
				<li>A transformative leader with a track record of building pivotal new businesses in complex, highly regulated environments. Led large-scale strategic pivots and developed new product and service generators for federal agencies and private industries.</li>
				<li>Excels at building multi-skillset teams capable of collaborating cross-functionally, with design, engineering, product, sales, marketing, and operations to drive innovation and align execution with ambitious goals.</li>
				<li>History of building high-performing teams that accelerate organizational maturity through identifying new product and service prospects concurrently with cost savings, revenue opportunities, and avoidance avenues to deliver high-quality experiences on time and under budget.</li>
			</ul>

			<a href="/scott-kellum-resume.docx" class="cta">Download Résumé</a>

			<h2 id="core-competencies">Core Competencies</h2>
