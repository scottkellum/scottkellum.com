---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';

let rolls = photos.rolls.slice(0, 12);

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const featuredPost = work.find((post) => post.data.featured);

const pinnedWriting = work
	.filter((post) => post.data.pinned && post.data.category === 'writing' && post.id !== featuredPost?.id)
	.slice(0, 2);

const pinnedWork = work
	.filter((post) => post.data.pinned && post.data.category === 'work')
	.slice(0, 2);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<main>
		<section class="cover" id="cover">
			<!-- <div class="masthead">
				<p>Human-centered and technology-driven design</p>
				<h1>Scott Kellum</h1>
			</div> -->
			{featuredPost && (
				<>
					{featuredPost.data.heroImage && <img class="cover-image" src={featuredPost.data.heroImage} alt={featuredPost.data.alt} />}
					<div class="cover-text">
						<h2 class="cover-hed"><a href={`/writing/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
						<p>{featuredPost.data.description}</p>
					</div>
				</>
			)}
		</section>
		<section class="writing" id="writing">
			{pinnedWriting.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="work" id="work">
			{pinnedWork.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="about" id="about">
			ABOUT
		</section>
		<section class="photography" id="photography">
			<h2><a href="/photos/">Photography</a></h2>
			{rolls.map((roll) => (
				<a class="item" href={`/photos#${rollID(roll.title)}`}>
					<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
				</a>
			))}
		</section>

	</main>
</Landing>

<style>
	html, body {
		scroll-snap-type: x proximity;
	}
	body {
		overflow-y: auto; /* PLACEHODLER */
	}
	main {
		writing-mode: sideways-lr;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
	section {
		scroll-snap-align: start;
		box-sizing: border-box;
		height: 100%;
		width: min(60rem, 90vw - (var(--gutter) * 2));
		padding: var(--gutter);
	}
	img {
		width: 100px;
	}

	/* COVER */

	.cover {
		position: relative;
		z-index: 9;
		width: 100vmin;
	}

	.cover-image {
		width: calc(100vmin - var(--gutter));
		height: calc(100vmin - var(--gutter));
		/* height: auto; */
		object-fit: cover;
		margin-inline: calc(var(--gutter) * -1) 0;
		margin-block: calc(var(--gutter) * -1) 0;
		display: block;
	}

	.cover-text {
		background-image: linear-gradient(90deg, color-mix(in srgb, transparent, var(--background)), var(--background));
		backdrop-filter: blur(3rem);
		margin-block: calc(var(--gutter) * -1);
		margin-inline: var(--gutter) 0;
		padding: var(--gutter);
		padding-inline: var(--gutter) 0;
		position: relative;
		z-index: 1;
		position: sticky;
		bottom: 0;
		border: 1px solid var(--background);
		border-width: 1px 0 0 1px;
	}
	.cover-hed {
		text-wrap: balance;
		font-size: max(8vmin, 2rem);
		line-height: 1;
		font-stretch: 60%;
		text-transform: uppercase;
		margin-block-end: 1rem;
		font-weight: 700;
		border-top: 1px solid var(--primary);
		padding-top: 1rem;
	}
	.cover-hed a {
		text-decoration: none;
	}


	.masthead {
		text-align: center;
		padding: var(--gutter);
	}
	.masthead h1 {
		font-weight: 400;
		font-width: 100%;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-block: 0;
		line-height: 1;
	}
	.masthead p {
		font-size: 1rem;
		margin-block: 0;
		font-style: italic;
	}

	/* PHOTOGRAPHY */

	.photography {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: calc(var(--gutter) / 2);
		--primary: #FF6C4B;
		height: min-content;
		padding: var(--gutter);
		margin-inline: 0 4rem;
		max-height: calc(100vh - 2rem);
		overflow: auto;
		background-color: var(--foreground);
		transition: transform 0.2s ease-in-out;
	}
	.photography h2 {
		font: inherit;
		font-family: var(--mono);
		color: var(--primary);
		grid-column: 1 / -1;
		width: fit-content;
		margin-block: 0 1rem;
		}
	.photography .item {
		line-height: 0;
	}
	.photography a {
		width: 100%;
		display: block;
		color: inherit;
	}
	.photography img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
	}
</style>
