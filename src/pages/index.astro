---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';

let rolls = photos.rolls.slice(0, 12);

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const featuredPost = work.find((post) => post.data.featured);

const pinnedWriting = work
	.filter((post) => post.data.pinned && post.data.category === 'writing' && post.slug !== featuredPost?.slug)
	.slice(0, 2);

const pinnedWork = work
	.filter((post) => post.data.pinned && post.data.category === 'work')
	.slice(0, 2);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<main>
		<section class="cover" id="cover">
			<div class="masthead">
				<p>Human-centered and technology-driven design</p>
				<h1>Scott Kellum</h1>
			</div>
			{featuredPost && (
				<>
					{featuredPost.data.heroImage && <img src={featuredPost.data.heroImage} alt={featuredPost.data.alt} />}
					<h2><a href={`/writing/${featuredPost.slug}/`}>{featuredPost.data.title}</a></h2>
					<p>{featuredPost.data.description}</p>
				</>
			)}
		</section>
		<section class="writing" id="writing">
			{pinnedWriting.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.slug}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="work" id="work">
			{pinnedWork.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.slug}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="about" id="about">
			ABOUT
		</section>
		<section class="photography" id="photography">
			<h2><a href="/photos/">Photography</a></h2>
			{rolls.map((roll) => (
				<a class="item" href={`/photos#${rollID(roll.title)}`}>
					<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
				</a>
			))}
		</section>

	</main>
</Landing>

<style>
	html, body {
		scroll-snap-type: x proximity;
	}
	body {
		overflow-y: auto; /* PLACEHODLER */
	}
	main {
		writing-mode: sideways-lr;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
	section {
		scroll-snap-align: start;
		box-sizing: border-box;
		height: 100%;
		width: min(60rem, 90vw - (var(--gutter) * 2));
		padding: var(--gutter);
	}
	img {
		width: 100px;
	}

	/* COVER */

	.cover {
	}
	.cover::before,
	.cover::after {
		pointer-events: none;
		content: '';
		position: absolute;
		inset: var(--gutter);
		z-index: -1;
	}
	.cover::before {
		background-image:
			radial-gradient(
			ellipse at 0% 100% in oklch,
			var(--gradient-stops) min(60rem, 90vw - (var(--gutter) * 2)));
		filter: url(#topography);
	}
	.cover::after {
		border: 1px solid rgb(104, 104, 104);
		mix-blend-mode: color-burn;
	}
@media (prefers-color-scheme: dark) {
		.cover::after {
		border-color: rgb(182, 182, 182);
			mix-blend-mode: color-dodge;
		}
	}

	.cover img {
		width: 50%;
		height: auto;
		object-fit: cover;
		margin-inline: calc(var(--gutter) * -0.5);
	}


	.masthead {
		text-align: center;
		padding: var(--gutter);
	}
	.masthead h1 {
		font-weight: 400;
		font-width: 100%;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-block: 0;
		line-height: 1;
	}
	.masthead p {
		font-size: 1rem;
		margin-block: 0;
		font-style: italic;
	}

	/* PHOTOGRAPHY */

	.photography {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--gutter);
		--primary: #FF6C4B;
		height: min-content;
	}
	.photography h2 {
		font: inherit;
		font-family: var(--mono);
		color: var(--primary);
		grid-column: 1 / -1;
	}
	.photography .item {
		line-height: 0;
	}
	.photography a {
		width: 100%;
		display: block;
		color: inherit;
	}
	.photography img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
	}
</style>
