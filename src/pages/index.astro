---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';

let rolls = photos.rolls;

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const pinnedPosts = work.filter((post) => post.data.pinned);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<section class="lede wrapper">
		<div class="content tt">
			<h1 class="page-head">Scott Kellum — Human-centered and technology-driven design</h1>
			<p>Scott Kellum is an internationally recognized leader in design with 20+ years of experience and a specialized focus on dynamic typography. Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to design problems, bringing people together to create focused, beautiful, and efficient solutions.</p>
		</div>
	</section>

	<main class="main wrapper" id="solutions">
		<section class="featured" id="featured-work">
			<h2 class="featured-head">Featured posts below. <a href="/portfolio">more work here</a> and <a href="/writing">more writing here</a>.</h2>

			<ul class="featured-list">
				{
					pinnedPosts.map((post) => (
						<li class="featured-post">
								<img src={post.data.heroImage} alt={post.data.alt} width="441" height="441" />
								<div class="work-container">
									<h3 class="head">
									<a href={`/writing/${post.slug}/`}>{post.data.title}</a>
								</h3>
								<p class="description">
									{post.data.description}
								</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="cta-group">
				<a class="cta" href="/portfolio/">More work</a>
				<a class="cta" href="/writing/">More writing</a>
			</div>

			<hr>

			<h2 class="featured-head">Photography</h2>
			<div class="home-filmstrip">
				{rolls.map((roll) => (
					<a class="item" href={`/photos#${rollID(roll.title)}`}>
						<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
					</a>
				))}
			</div>
			
		</section>

	</main>
</Landing>

<style>
	main {
		writing-mode: sideways-lr;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
</style>
