---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Card from '../components/Card.astro';
import KeepScrolling from '../components/KeepScrolling.astro';

import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import photos from '../data/photos.json'

let rolls = photos.rolls;

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const pinnedPosts = work.filter((post) => post.data.pinned);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<section class="lede wrapper">
		<div class="content tt">
			<h1 class="page-head">Scott Kellum — Human-centered and technology-driven design</h1>
			<p>Scott Kellum is an internationally recognized leader in web design, with a specialized focus on dynamic typesetting in digital space. In addition to his web design expertise, Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to web design problems, bringing together advertising, editorial, and engineering teams to create focused, beautiful, and efficient solutions.</p>
			<p>Scott takes a multi-stakeholder approach to everything he does. His inclusive concept of customer-centered product development means his work speaks to stakeholders up and down the product chain, while always optimizing for the customer to create easy-to-use, easy-to-maintain products for individuals and organizations.</p>
		</div>
	</section>

	<KeepScrolling />
	
	<Nav />

	<main class="main wrapper" id="solutions">
		<section class="featured" id="featured-work">
			<hr>
			<h2 class="featured-head">Work with me</h2>
			<p class="current-work">I run a full-service design studio, <a href="https://typetura.com" target="_blank">Typetura</a>, where we showcase client value through innovative branding and high-quality websites.</p>
			<p class="current-work">You can also view my <a href="/resume">résumé</a> to see my extensive design experience.</p>
			<hr>
			<h2 class="featured-head">Photography</h2>
			<div class="home-filmstrip">
				{rolls.map((roll) => (
					<a class="item" href={`/photos#${rollID(roll.title)}`}>
						<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
					</a>
				))}
			</div>
		<hr>
			<h2 class="featured-head">Featured posts below. <a href="/work">more work here</a> and <a href="/writing">more writing here</a>.</h2>

			<ul class="featured-list">
				{
					pinnedPosts.map((post) => (
						<li class="featured-post">
								<img src={post.data.heroImage} alt={post.data.alt} width="441" height="441" />
								<div class="work-container">
									<h3 class="head">
									<a href={`/work/${post.slug}/`}>{post.data.title}</a>
								</h3>
								<p class="description">
									{post.data.description}
								</p>
							</div>
						</li>
					))
				}
			</ul>

			<div class="cta-group">
				<a class="cta" href="/work/">More work</a>
				<a class="cta" href="/writing/">More writing</a>
			</div>

		</section>

</main>
</Landing>

<style>
	.current-work {
		font-size: 2rem;
		line-height: 1.35;
		animation-name: home-lede-content;
		text-wrap: pretty;
	}
	@keyframes home-lede-content {
		0% {
			font-size: 1rem;
		}
		100% {
			font-size: 2rem;
		}
	}

	.home-filmstrip {
		width: 100cqb;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		overflow: auto;
		margin-block: 1rem;
		writing-mode: vertical-lr;
		margin: 0;
		padding: 1rem var(--margin);
		box-sizing: border-box;
		scrollbar-width: thin;
		scrollbar-color: var(--primary) transparent;
	}
	.home-filmstrip img {
		height: 10rem;
		width: auto;
		display: block;
		margin: 0;
	}
	.home-filmstrip a {
		display: block;
		text-decoration: none;
		margin: 0;
		margin-block-end: 0.5rem;
		border-radius: 0.5rem;
		overflow: hidden;
	}
	.home-filmstrip a:last-child {
		margin-block-end: 0;
	}

	.lede .page-head,
	.featured-head {
		font-family: var(--font);
		font-size: 0.8rem;
		animation-name: none;
		color: var(--primary-dark);
		letter-spacing: 0.05em;
		font-weight: 400;
		font-style: italic;
	}

	@media (min-width: 40em) {
		.card-container {
			width: calc(100% + 2rem);
			display: flex;
			gap: 1em;
			margin-inline: -1rem;
			margin-block: 2rem;
		}
	}

	.featured {
		grid-column: 2 / 3;
		/* text-align: center; */
	}

	.featured-list {
		margin: 0;
		padding: 0;
		width: 100%;
		list-style: none;
	}

	.featured-post {
		margin: 0;
		margin-block: 2rem;
		gap: 1rem;
		width: 100%;
		position: relative;
	}
	.featured-post::before,
	.featured-post::after {
		content: '';
		position: absolute;
		display: block;
		top: -0.5px;
		right: 100%;
		width: 50vw;
		height: 1px;
		background-color: var(--accent-dark);
		transition: background-color var(--speed) ease-in-out;
	}
	.featured-post::after {
		top: -3rem;
		left: -0.5px;
		width: 1px;
		height: 3rem;
		color: var(--accent-dark);
		background: linear-gradient(0deg, currentcolor, transparent);
		transition: color var(--speed) ease-in-out;
	}
	.featured-post > * {
		flex: 1;
	}

	.featured-post img {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		margin: 0.5px;
		outline: 1px solid var(--accent-dark);
		object-fit: cover;
		transition: outline-color var(--speed) ease-in-out;
	}
	.featured-post:has(a:hover) .work-container {
		border-color: var(--action-neutral);
	}
	.featured-post:has(a:hover)::before {
		background-color: var(--action-neutral);
	}
	.featured-post:has(a:hover)::after {
		color: var(--action-neutral);
	}
	.featured-post:has(a:hover) img {
		outline-color: var(--action-neutral);
	}

	.featured-post a {
		position: static !important;
		text-decoration: none;
		transition: color var(--speed) ease-in-out;
	}
	.featured-post a:hover {
		color: var(--action);
	}
	.featured-post a::after {
		content: '';
		position: absolute;
		display: block;
		inset: 0;
	}
	.featured-post a:focus::before {
		border-start-end-radius: 4rem;
		border-end-start-radius: 4rem;
	}

	@media (min-width: 40em) {
		.featured-post {
			margin-block: 1rem 3rem;
			display: flex;
		}
		.featured-post img {
			width: 1px;
			border-radius: 0.1px 4rem 0.1px 4rem;
		}
		.featured-post .work-container {
			align-self: flex-end;
			border-bottom: 1px solid var(--accent-dark);
			margin-block-end: -0.5px;
			margin-inline-end: 1rem;
			transition: border-color var(--speed) ease-in-out;
		}
	}

  .more-work:hover,
  .more-work:focus,
  .more-work:active {
    text-decoration: underline;
    text-decoration-color: var(--action-neutral);
  }
</style>