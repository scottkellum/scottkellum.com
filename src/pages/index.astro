---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';

let rolls = photos.rolls.slice(0, 12);

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const featuredPost = work.find((post) => post.data.featured);

const pinnedWriting = work
	.filter((post) => post.data.pinned && post.data.category === 'writing' && post.slug !== featuredPost?.slug)
	.slice(0, 2);

const pinnedWork = work
	.filter((post) => post.data.pinned && post.data.category === 'work')
	.slice(0, 2);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<main>
		<section class="cover" id="cover">
			<div class="masthead">
				<p>Human-centered and technology-driven design</p>
				<h1>Scott Kellum</h1>
			</div>
			{featuredPost && (
				<>
					{featuredPost.data.heroImage && <img src={featuredPost.data.heroImage} alt={featuredPost.data.alt} />}
					<h2><a href={`/writing/${featuredPost.slug}/`}>{featuredPost.data.title}</a></h2>
					<p>{featuredPost.data.description}</p>
				</>
			)}
		</section>
		<section class="writing" id="writing">
			{pinnedWriting.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.slug}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="work" id="work">
			{pinnedWork.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.slug}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="about" id="about">
			ABOUT
		</section>
		<section class="photography" id="photography">
			<h2><a href="/photos/">Photography</a></h2>
			{rolls.map((roll) => (
				<a class="item" href={`/photos#${rollID(roll.title)}`}>
					<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
				</a>
			))}
		</section>

	</main>
</Landing>

<style>
	html, body {
		scroll-snap-type: x proximity;
	}
	body {
		overflow-y: auto; /* PLACEHODLER */
	}
	main {
		writing-mode: sideways-lr;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
	section {
		scroll-snap-align: start;
		box-sizing: border-box;
		height: 100%;
		width: min(60rem, 90vw - (var(--gutter) * 2));
		padding: var(--gutter);
	}
	img {
		width: 100px;
	}

	/* COVER */

	.cover {
	}
	.cover::before {
		content: '';
		position: absolute;
		inset: 0;
		inset-inline: var(--gutter);
		background-image:
			radial-gradient(
			ellipse at 0% 100% in oklch,
			var(--gradient-stops) min(60rem, 90vw - (var(--gutter) * 2)));
		filter: url(#topography);
		opacity: 0.5;
		z-index: -2;
	}
	.cover::after {
		content: '';
		position: absolute;
		inset: 0;
		inset-inline: var(--gutter);
		width: 1px;
		z-index: -1;
		background: rgb(104, 104, 104);
		mix-blend-mode: color-burn;
	}
@media (prefers-color-scheme: dark) {
		.cover::after {
		background: rgb(182, 182, 182);
			mix-blend-mode: color-dodge;
		}
	}

	.cover img {
		width: 100%;
		height: auto;
		object-fit: cover;
		margin-inline-start: calc(var(--gutter) * -1);
	}

	.masthead {
		color: var(--primary);
	}
	.masthead h1 {
		font-weight: 400;
		font-width: 100%;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		margin-block: 0;
		line-height: 1;
	}
	.masthead p {
		font-size: 1rem;
		margin-block: 0;
		font-style: italic;
	}
</style>
