---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';
import HomeStamp from '../components/HomeStamp.astro';

let rolls = photos.rolls;

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const featuredPost = work.find((post) => post.data.featured);

const pinnedWriting = work
	.filter((post) => post.data.pinned && post.data.category === 'writing' && post.id !== featuredPost?.id)
	.slice(0, 2);

const pinnedWork = work
	.filter((post) => post.data.pinned && post.data.category === 'work')
	.slice(0, 2);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<main>
  	<section class="masthead">
  		<img src="/headshot.avif" alt="Scott Kellum headshot" />
  		<div class="text">
        <div class="top">
     			<h1 class="eyebrow"><span class="hidden">Scott Kellum | </span>Human-centered and technology-driven design</h1>
    			<h2 class="hed" aria-hidden="true">Scott Kellum</h2>
    			<p>Scott is an internationally recognized leader in design with 20+ years of experience and a specialized focus on dynamic typography. Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to design problems, bringing people together to create focused, beautiful, and efficient solutions.</p>
          <div class="meta">
            <a href="/resume">Résumé</a>
            <a href="mailto:scott@scottkellum.com">scott@scottkellum.com</a>
            <a rel="me" href="https://typo.social/@scott" target="_blank">Mastodon</a>
            <ul class="locations">
              <li class="current">Madrid, Spain</li>
              <li>Los Angeles, CA</li>
              <li>New York, NY</li>
            </ul>
          </div>
        </div>
        <div class="bottom">
          <div class="colophon">
            <p>The text is set in <a href="https://ivyfoundry.com/families/ivypresto/" target="_blank">IvyPresto from Ivy Foundry</a> and served with <a href="https://typographer.com/" target="_blank">Typographer</a>. Headlines are set in <a href="https://connary.com/fonts/wayfinder/" target="_blank">Wayfinder by Connary Fagen</a> and served with <a href="https://typographer.com/" target="_blank">Typographer</a>. Cover headlines are set in <a href="https://www.futurefonts.com/cinketype/kass" target="_blank">Kass by Cinketype</a>. <a href="https://www.futurefonts.com/rudiger/arnold" target="_blank">Arnold by Rüdiger</a> is used for supporting text.</p>
            <p>Special thanks to <a href="https://kizu.dev/">Roman Komarov</a> for assistance with some of the pagination CSS.</p>
          </div>
        </div>
  		</div>
  	</section>
		<section class="cover" id="cover">
		  <HomeStamp />
			{featuredPost && (
				<>
					{featuredPost.data.heroImage && <img class="cover-image" src={featuredPost.data.heroImage} alt={featuredPost.data.alt} />}
					<div class="cover-text">
						<h2 class="cover-hed"><a href={`/writing/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
						<p>{featuredPost.data.description}</p>
					</div>
				</>
			)}
		</section>
		<section class="writing" id="writing">
			{pinnedWriting.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<div class="text">
						<h2 class="hed"><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
					</div>
				</article>
			))}
		</section>
		<section class="work" id="work">
			{pinnedWork.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<div class="text">
						<h2 class="hed"><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
					</div>
				</article>
			))}
		</section>
		<section class="photography" id="photography">
			<h2><a href="/photos/">Photography</a></h2>
			{rolls.map((roll) => (
				<a class="item" href={`/photos#${rollID(roll.title)}`}>
					<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
				</a>
			))}
		</section>

	</main>
</Landing>

<style>
	html, body {
		scroll-snap-type: x proximity;
	}
	body {
		overflow-y: auto; /* PLACEHODLER */
	}
	main {
		writing-mode: sideways-lr;
		display: flex;
		flex-direction: column;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
	section {
		scroll-snap-align: start;
		box-sizing: border-box;
		height: 100%;
		width: min(60rem, 90vw - (var(--gutter) * 2));
		padding: var(--gutter);
	}
	img {
		width: 100px;
	}

	/* COVER */

	.cover {
		position: relative;
		z-index: 9;
		width: 100vmin;
		background: var(--primary);
	}
	.cover,
	.cover::scroll-marker {
  	order: -1;
	}

	.cover-image {
		width: calc(100vmin - (var(--gutter) * 2));
		height: calc(100vmin - (var(--gutter) * 1));
		/* height: auto; */
		object-fit: cover;
		margin-inline: 0;
		margin-block: calc(var(--gutter) * -1) 0;
		display: block;
	}

	.cover-text {
		margin: 0;
		padding-block: 0 var(--gutter);
		position: relative;
		z-index: 1;
		position: sticky;
		bottom: 0;
	}
	.cover-hed {
		text-wrap: balance;
		text-align: center;
		font-family: var(--font-cover);
		font-style: italic;
		font-weight: 900;
		font-size: max(12vmin, 2rem);
		padding-inline: 0.5em;
		rotate: -5deg;
		line-height: 0.9;
		font-stretch: 60%;
		margin-block-end: 10vb;
		text-shadow: 0.08em 0.08em 0 var(--primary);
		-webkit-text-stroke: 0.08em var(--primary);
		paint-order: stroke fill;
		will-change: scale;
	}
	.cover-text p {
	  font-family: var(--font-meta);
  	max-width: 30rem;
    background-color: var(--primary);
    margin-inline: 0 auto;
    padding: 1rem;
    padding-block-end: 0;
    padding-inline-start: 0;
    text-box: trim-both cap alphabetic;
    text-wrap: pretty;
	}
	.cover-hed a {
		text-decoration: none;
	}


	.masthead {
	overflow: auto;
		padding: var(--gutter);
		background-color: var(--background);
		max-width: none;
		grid-template-columns: 1fr 2fr;
		align-items: start;
		gap: var(--gutter);
		border-inline-start: 1px solid var(--border);
	}

	.masthead img {
		width: 60%;
		mix-blend-mode: var(--blend);
		display: block;
		rotate: 180deg;
		translate: calc(var(--gutter) * -1) calc(var(--gutter) * -1);
	}

	.masthead .eyebrow {
		text-transform: uppercase;
		font-family: var(--font-meta);
		font-size: 0.8rem;
		padding-block: 0.3em;
		text-wrap: balance;
	}
	.masthead .hed {
		font-family: var(--font-display);
    font-size: 3rem;
    /*line-height: 1;*/
    margin-block: 1rlh 0;
	}
	.masthead p {
		font-size: 1.15rem;
	}
	.masthead .text {
    height: calc(100dvh - (var(--gutter) * 3));
    padding-inline-end: 1ch;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
	}
	.masthead p:not(:first-of-type) {
		text-indent: 25%;
	}

	.masthead .meta,
	.masthead .bottom p {
    font-family: var(--mono);
    font-size: 0.8rem;
	}

	.masthead .bottom {
  	overflow: hidden;
    margin-block: 2rem 0.25rem;
    min-height: fit-content;
	}

	.masthead .meta {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		margin-block: 1em;
	}
	.masthead .meta > * {
	  font: unset;
	}

	@media (width > 40rem) {
		.masthead {
			display: grid;
			overflow: hidden;
		}
		.masthead img {
			width: 200%;
			translate: -50% calc(var(--gutter) * -1);
		}
		.masthead .text {
			overflow: auto;
			border-block: 1px solid var(--border);
		}
	}

	/* Writing and Work */

	.writing,
	.work,
	.photography {
  	border-inline-start: 1px solid var(--border);
	}

	/* PHOTOGRAPHY */

	.photography {
  	background-color: #000;
    color: #ddd;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
		overflow: auto;
	}
	.photography h2 {
		font: inherit;
		font-family: var(--font-display);
		font-size: 2rem;
		grid-column: 1 / -1;
		width: fit-content;
		margin-block: 0;
		position: sticky;
		top: 0;
		mix-blend-mode: screen;
		}
	.photography .item {
		line-height: 0;
	}
	.photography a {
		width: 100%;
		display: block;
		color: inherit;
	}
	.photography img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
	}
</style>
