---
import Landing from '../layouts/Landing.astro';
import { SITE_DESCRIPTION } from '../consts';

import { getCollection } from 'astro:content';
import photos from '../data/photos.json'
import Testimonials from '../components/Testimonials.astro';
import HomeStamp from '../components/HomeStamp.astro';

let rolls = photos.rolls.slice(0, 12);

interface MarkdownFrontmatter {
	publishDate: number;
}

function rollID(t) {
  t = t.replaceAll('[', '');
  t = t.replaceAll(']', '');
  t = t.replaceAll(' ', '-');
  return t;
}

const work = (await getCollection('work')).sort(
	(b, a) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const featuredPost = work.find((post) => post.data.featured);

const pinnedWriting = work
	.filter((post) => post.data.pinned && post.data.category === 'writing' && post.id !== featuredPost?.id)
	.slice(0, 2);

const pinnedWork = work
	.filter((post) => post.data.pinned && post.data.category === 'work')
	.slice(0, 2);
---

<Landing title="Scott Kellum — Human-centered and technology-driven design" description={SITE_DESCRIPTION}>

	<main>
  	<section class="masthead">
  		<img src="/headshot.jpg" alt="Scott Kellum headshot" />
  		<div class="text">
   			<h1 class="eyebrow"><span class="hidden">Scott Kellum | </span>Human-centered and technology-driven design</h1>
  			<h2 class="hed" aria-hidden="true">Scott Kellum</h2>
  			<p>Scott is an internationally recognized leader in design with 20+ years of experience and a specialized focus on dynamic typography. Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to design problems, bringing people together to create focused, beautiful, and efficient solutions.</p>
  			<p>Scott is an internationally recognized leader in design with 20+ years of experience and a specialized focus on dynamic typography. Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to design problems, bringing people together to create focused, beautiful, and efficient solutions.</p>
  			<p>Scott is an internationally recognized leader in design with 20+ years of experience and a specialized focus on dynamic typography. Scott brings two decades of involvement and partnership with some of the most well-respected teams in design, including Darden Studio, Fjord, and Vox Media. While in these roles, Scott successfully built cross-organizational buy-in for his unique approaches to design problems, bringing people together to create focused, beautiful, and efficient solutions.</p>
  		</div>
  	</section>
		<section class="cover" id="cover">
		  <HomeStamp />
			{featuredPost && (
				<>
					{featuredPost.data.heroImage && <img class="cover-image" src={featuredPost.data.heroImage} alt={featuredPost.data.alt} />}
					<div class="cover-text">
						<h2 class="cover-hed"><a href={`/writing/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
						<p>{featuredPost.data.description}</p>
					</div>
				</>
			)}
		</section>
		<section class="writing" id="writing">
			{pinnedWriting.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="work" id="work">
			{pinnedWork.map((post) => (
				<article>
					{post.data.heroImage && <img src={post.data.heroImage} alt={post.data.alt} />}
					<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
					<p>{post.data.description}</p>
				</article>
			))}
		</section>
		<section class="about" id="about">
			ABOUT
		</section>
		<section class="photography" id="photography">
			<h2><a href="/photos/">Photography</a></h2>
			{rolls.map((roll) => (
				<a class="item" href={`/photos#${rollID(roll.title)}`}>
					<img loading="lazy" src={`/photos/${roll.photos[0].src}`} alt={roll.photos[0].alt}>
				</a>
			))}
		</section>

	</main>
</Landing>

<style>
	html, body {
		scroll-snap-type: x proximity;
	}
	body {
		overflow-y: auto; /* PLACEHODLER */
	}
	main {
		writing-mode: sideways-lr;
		display: flex;
		flex-direction: column;
	}
	main > * {
		writing-mode: horizontal-tb;
	}
	section {
		scroll-snap-align: start;
		box-sizing: border-box;
		height: 100%;
		width: min(60rem, 90vw - (var(--gutter) * 2));
		padding: var(--gutter);
	}
	img {
		width: 100px;
	}

	/* COVER */

	.cover {
		position: relative;
		z-index: 9;
		width: 100vmin;
		background: var(--primary);
	}
	.cover,
	.cover::scroll-marker {
  	order: -1;
	}

	.cover-image {
		width: calc(100vmin - (var(--gutter) * 2));
		height: calc(100vmin - (var(--gutter) * 1));
		/* height: auto; */
		object-fit: cover;
		margin-inline: 0;
		margin-block: calc(var(--gutter) * -1) 0;
		display: block;
	}

	.cover-text {
		margin: 0;
		padding-block: 0 var(--gutter);
		position: relative;
		z-index: 1;
		position: sticky;
		bottom: 0;
	}
	.cover-hed {
		text-wrap: balance;
		text-align: center;
		font-family: var(--font-cover);
		font-style: italic;
		font-weight: 900;
		font-size: max(12vmin, 2rem);
		padding-inline: 0.5em;
		rotate: -5deg;
		line-height: 0.9;
		font-stretch: 60%;
		margin-block-end: 10vb;
		text-shadow: 0.08em 0.08em 0 var(--primary);
		-webkit-text-stroke: 0.08em var(--primary);
		paint-order: stroke fill;
		will-change: scale;
	}
	.cover-text p {
	  font-family: var(--font-meta);
  	max-width: 30rem;
    background-color: var(--primary);
    margin-inline: 0 auto;
    padding: 1rem;
    padding-block-end: 0;
    padding-inline-start: 0;
    text-box: trim-both cap alphabetic;
    text-wrap: pretty;
	}
	.cover-hed a {
		text-decoration: none;
	}


	.masthead {
		padding: var(--gutter);
		background-color: var(--background);
		max-width: none;
		grid-template-columns: 1fr 2fr;
		align-items: start;
		gap: var(--gutter);
	}

	.masthead img {
		width: 100%;
		mix-blend-mode: var(--blend);
		display: block;
		opacity: 0.5;
	}

	.masthead .eyebrow {
		text-transform: uppercase;
		font-family: var(--font-meta);
		font-size: 0.8rem;
		padding-block: 0.3em;
		text-wrap: balance;
	}
	.masthead .hed {
		font-family: var(--font-display);
    font-size: 3rem;
    /*line-height: 1;*/
    margin-block: 1rlh 0;
	}
	.masthead p {
		font-size: 1.15rem;
	}
	.masthead .text {
    height: calc(100dvh - (var(--gutter) * 3));
    overflow: auto;
    padding-inline-end: 1ch;
	}
	.masthead .text::after {
		content: "";
		position: sticky;
		display: block;
		height: 2lh;
		width: 100%;
		bottom: 0;
		background: linear-gradient(to top, var(--background), transparent);
	}
	.masthead p:not(:first-of-type) {
		text-indent: 25%;
	}

	@media (width > 40rem) {
		.masthead {
			display: grid;
		}
		.masthead .text {
			border-top: 1px solid color-mix(in srgb, currentColor 50%, transparent);
		}
	}

	/* PHOTOGRAPHY */

	.photography {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: calc(var(--gutter) / 2);
		--primary: #FF6C4B;
		height: min-content;
		padding: var(--gutter);
		margin-inline: 0 4rem;
		max-height: calc(100vh - 2rem);
		overflow: auto;
		background-color: var(--foreground);
		transition: transform 0.2s ease-in-out;
	}
	.photography h2 {
		font: inherit;
		font-family: var(--mono);
		color: var(--primary);
		grid-column: 1 / -1;
		width: fit-content;
		margin-block: 0 1rem;
		}
	.photography .item {
		line-height: 0;
	}
	.photography a {
		width: 100%;
		display: block;
		color: inherit;
	}
	.photography img {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: contain;
	}
</style>
