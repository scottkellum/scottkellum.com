<style>
.home-stamp {
  font-size: max(32vmin, 6rem);
  position: absolute;
  top: 0;
  left: 2rem;
  width: 1em;
  height: 1em;
  display: grid;
  place-items: center;
  color: #000;
  overflow: hidden;
}
.home-stamp > svg {
  grid-area: 1 / 1;
  margin-block-start: -.4em;
}
.home-stamp-rings {
  width: 100%;
  height: 100%;
  overflow: visible;
  animation: home-stamp-rings 60s linear infinite;
}
@keyframes home-stamp-rings {
  from {
    transform: rotate(0turn);
  }
  to {
    transform: rotate(-1turn);
  }
}
.home-stamp-logo {
  width: 0.633em;
  height: 0.633em;
}
.home-stamp-ring {
  font-family: var(--mono);
  font-style: italic;
  font-size: 0.03em;
  text-transform: uppercase;
  fill: currentColor;
  transform-box: view-box;
  transform-origin: 50% 50%;
  animation: home-stamp-spin 90s linear infinite;
}
</style>
