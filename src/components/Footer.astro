---
import IconLinkedIn from '../components/IconLinkedIn.astro';
import IconMastodon from '../components/IconMastodon.astro';
import IconGithub from '../components/IconGithub.astro';
import IconTypetura from '../components/IconTypetura.astro';
import IconRSS from '../components/IconRSS.astro';
const today = new Date();
---

<footer class="footer wrapper">

	<div class="content">
		<div class="link-wrapper">
			<div class="cta links">
				<a href="/">Home</a>
				<a href="/portfolio" target="_blank">Portfolio</a>
				<a href="/resume" target="_blank">Résumé</a>
			</div>
			<div class="internal links">
				<a href="/writing">Writing</a>
				<a href="/photos">Photos</a>
				<a href="/rss.xml" target="_blank">RSS <IconRSS /></a>
			</div>
			<div class="social links">
				<a href="mailto:scott@scottkellum.com"> Email</a>
				<a href="https://typetura.com" target="_blank" rel="noopener noreferrer"><IconTypetura /> Typetura</a>
				<a href="https://typetura.social/@scott" target="_blank" rel="noopener noreferrer"><IconMastodon /> Mastodon</a>
				<a href="https://github.com/scottkellum" target="_blank" rel="noopener noreferrer"><IconGithub /> Github</a>
				<a href="https://www.linkedin.com/in/scott-kellum/" target="_blank" rel="noopener noreferrer"><IconLinkedIn /> LinkedIn</a>
			</div>
		</div>

		<div class="copyright">
			&copy; {today.getFullYear()} Scott Kellum. All rights reserved.
		</div>

	</div>
</footer>

<style>
	.footer {
		padding: 0;
		overflow: hidden;
		background-color: var(--background);
		border-block-start: 1px solid var(--accent-dark);
		font-family: var(--gamay);
		font-size: 0.8rem;
	}
	.content {
		outline: 1px dashed var(--accent-dark);
		margin-inline: 0.5px;
		padding-block: 2rem 1rem;
		width: calc(100% - 1px);
	}
	.link-wrapper {
		display: flex;
		margin-block: 1rem 3rem;
		gap: 1rem;
		justify-content: center;
	}
	.links {
		display: flex;
		flex-direction: column;
		margin: 0 1em;
		gap: 0.5em;
	}
	.links a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
	}
	.links a:hover {
		text-decoration: underline;
		color: var(--action);
	}

	.cta {
		color: var(--action);
	}
	.copyright {
		margin-block: 1rem;
		text-align: center;
		color: var(--primary-dark);
		text-wrap: balance;
	}

	@media (max-width: 30em) {
		.footer {
			font-size: 1rem;
		}
		.link-wrapper {
			flex-direction: column;
			gap: 1rem;
		}
		.copyright {
			font-size: 0.8rem;
		}
	}
</style>